# Copy to .env for local development. Never put production values in a working copy,
# and never start a production env file from this one: MODE=dev below would override
# the image's MODE=prod. Each variable: what it is, whether production needs it, and
# whether it is a secret. docs/configuration.md has the full table.

# --- framework -------------------------------------------------------------
# dev | prod. Unset means dev, and dev puts the error and a stack trace in 500s.
# Production: prod (the image sets it). Not secret.
MODE=dev
# Port the server listens on and `app healthcheck` probes. Required. Not secret.
SERVER_PORT=8080
# The app's own origin: absolute URLs, and the same-origin check. Required. Not secret.
APP_URL=http://localhost:8080

# --- database (make dev-up starts it from compose.yaml) --------------------
# Required in production. Not secret.
DB_HOST=127.0.0.1
# Required in production. Not secret. Change it here if 5432 is taken locally.
DB_PORT=5432
# Required in production. Not secret.
DB_USER=myapp
# Required in production. SECRET.
DB_PASSWORD=change-me
# Required in production. Not secret.
DB_NAME=myapp_dev
# disable locally; require (or stricter) in production. Not secret.
DB_SSL=disable

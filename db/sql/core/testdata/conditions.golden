=== exists/every-clause
sql:  "EXISTS (SELECT DISTINCT ON (o.user_id) o.user_id, COUNT(*) FROM (SELECT id FROM orders WHERE status = ? LIMIT 1) AS o INNER JOIN users ON users.id = o.user_id LEFT JOIN (SELECT id FROM refunds WHERE status = ? LIMIT 1) AS r ON r.id = o.id AND r.amount > ? CROSS JOIN regions WHERE users.active = ? AND o.deleted_at IS NULL GROUP BY o.user_id HAVING COUNT(*) > ? ORDER BY o.user_id desc, COUNT(*) LIMIT 10 OFFSET 20)"
args: [string("paid"), string("open"), int(0), bool(true), int(2)]


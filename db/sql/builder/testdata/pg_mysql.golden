# Golden file for TestPostgresAndMySQLOutputMatchesGolden (db/sql/builder/dialect_golden_test.go).
# Each builder case rendered through PostgresDialect and MySQLDialect, and the ON CONFLICT
# cases through MySQLDialect{AllowUnfaithfulUpsert: true} as well.
#
# Regenerate from the module root, then review the diff like any other change:
#   go test ./db/sql/builder -run Golden -update
#
# sql is Go-quoted. args lists each bound value with its dynamic type; "nil" is a nil
# slice and "[]" an empty one. err is a refusal: "unsupported" for a core.UnsupportedError,
# "error" for any other, then the message.

=== cte/every-clause [mysql]
err:  unsupported "mysql does not support DISTINCT ON; rewrite as a ROW_NUMBER() window function in a subquery filtered to rn = 1"

=== cte/every-clause [postgres]
sql:  "WITH s AS (SELECT DISTINCT ON (o.user_id) o.user_id, COUNT(*) AS n FROM orders o INNER JOIN users u ON u.id = o.user_id WHERE o.status = ? GROUP BY o.user_id HAVING COUNT(*) > ? ORDER BY \"o\".\"user_id\" DESC LIMIT 5 OFFSET 10) SELECT * FROM s"
args: [string("paid"), int(2)]

=== cte/several [mysql]
sql:  "WITH paid AS (SELECT user_id FROM orders WHERE status = ?), big AS (SELECT user_id FROM orders WHERE total > ?) SELECT paid.user_id FROM paid INNER JOIN big ON big.user_id = paid.user_id"
args: [string("paid"), int(1000)]

=== cte/several [postgres]
sql:  "WITH paid AS (SELECT user_id FROM orders WHERE status = ?), big AS (SELECT user_id FROM orders WHERE total > ?) SELECT paid.user_id FROM paid INNER JOIN big ON big.user_id = paid.user_id"
args: [string("paid"), int(1000)]

